/* bun_nltk architecture — TS+Rust to native/WASM to Bun/Node/Browser/Edge */
digraph architecture {
  graph [fontname="Helvetica", bgcolor="transparent", pad="0.35", ranksep="0.38", nodesep="0.28", rankdir="TB", splines="ortho", labelloc="t", label="bun_nltk Architecture  (TypeScript + Rust -> native / WASM)", fontsize="10", fontcolor="#333333", compound="true"];
  node [fontname="Helvetica", fontsize="8.5", shape="box", style="rounded,filled", fillcolor="#f8f9fa", color="#333333", penwidth="0.8", margin="0.18,0.09"];
  edge [fontname="Helvetica", fontsize="7", color="#555555", arrowsize="0.7", penwidth="0.9"];

  subgraph cluster_source {
    graph [label="Source", fontsize="8", fontcolor="#333333", style="rounded,filled", fillcolor="#f8f9ff", color="#dadce0", penwidth="0.7", margin="12", labeljust="l"];
    ts [label="TypeScript  src/\nfunctional APIs + fallbacks", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0"];
    rs [label="Rust  rust/src/\ntoken / linear / HMM / K-means / WordNet", shape="box", style="rounded,filled", fillcolor="#fef7e0", color="#e37400", penwidth="1.0"];
    ts -> rs [style="invis"];
  }

  subgraph cluster_build {
    graph [label="Build", fontsize="8", fontcolor="#333333", style="rounded,filled", fillcolor="#f6fef9", color="#dadce0", penwidth="0.7", margin="12", labeljust="l"];
    tsc [label="tsc  /  bun build", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0"];
    cargo [label="cargo build + cargo zigbuild\nmacOS arm64 / Linux x64 / Windows x64", shape="box", style="rounded,filled", fillcolor="#fef7e0", color="#e37400", penwidth="1.0"];
    wasm [label="cargo build --target wasm32\nbun_nltk.wasm  93,712 bytes", shape="box", style="rounded,filled", fillcolor="#fce8e6", color="#c5221f", penwidth="1.0", fontsize="8"];
    tsc -> cargo [style="invis"];
    cargo -> wasm [style="invis"];
  }

  subgraph cluster_runtime {
    graph [label="Runtime / Distribution", fontsize="8", fontcolor="#333333", style="rounded,filled", fillcolor="#fff8f0", color="#dadce0", penwidth="0.7", margin="12", labeljust="l"];
    bunffi [label="Bun bindings\nbun:ffi  dlopen  (native)", shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#1e8e3e", penwidth="1.0"];
    wasmbind [label="Explicit WASM wrapper\nWasmNltk.init(bytes or path)", shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#1e8e3e", penwidth="1.0"];
    gate [label="release:local + native-host reports\n37 fidelity groups + performance/size gates\nmacOS author run; Linux / Windows on their native hosts", shape="plaintext", fontsize="6.5", fontcolor="#5f6368", height="0.18"];
    npm [label="npm package\nTS + 3 prebuilts + WASM", shape="box", style="rounded,filled", fillcolor="#f3e8fd", color="#7c4dff", penwidth="1.0"];
  }

  subgraph cluster_targets {
    graph [label="Targets (single codebase)", fontsize="8", fontcolor="#333333", style="rounded,filled", fillcolor="#f8f9fa", color="#dadce0", penwidth="0.7", margin="12", labeljust="l"];
    bun_rt [label="Bun\npackaged native", shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#1e8e3e", penwidth="1.0"];
    nodejs [label="Bun / Node\nexplicit WASM", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0"];
    browser [label="Browser harness\nChromium + Firefox", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0"];
    edge_rt [label="Edge targets\nnot yet validated", shape="box", style="rounded,filled", fillcolor="#fef7e0", color="#e8a317", penwidth="1.0"];
    bun_rt -> nodejs -> browser -> edge_rt [style="invis"];
  }

  ts -> tsc [ltail="cluster_source"];
  rs -> cargo;
  rs -> wasm [style="dashed", label="  wasm32  ", fontsize="6.5"];
  cargo -> bunffi [ltail="cluster_build", lhead="cluster_runtime"];
  wasm -> wasmbind [ltail="cluster_build", lhead="cluster_runtime"];
  tsc -> npm [ltail="cluster_build", lhead="cluster_runtime"];
  bunffi -> npm [style="solid"];
  wasmbind -> npm [style="solid"];

  npm -> bun_rt [lhead="cluster_targets"];
  npm -> nodejs [lhead="cluster_targets"];
  npm -> browser [lhead="cluster_targets"];
  npm -> edge_rt [lhead="cluster_targets"];

  bunffi -> bun_rt [color="#1e8e3e", penwidth="1.4"];
  wasmbind -> browser [color="#1e8e3e"];
  wasmbind -> edge_rt [color="#1e8e3e"];

  gate -> npm [style="dotted", color="#5f6368", arrowhead="none", penwidth="0.7"];

  fb [label="Native and WASM are explicit APIs; no Python sidecar or install-time compilation", shape="plaintext", fontsize="6.5", fontcolor="#5f6368", height="0.2"];
  { rank="sink"; fb; }
}
