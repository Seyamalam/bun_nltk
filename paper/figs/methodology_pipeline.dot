/* bun_nltk methodology pipeline — scrape → checklist → port → harness → docs */
digraph methodology_pipeline {
  graph [fontname="Helvetica", bgcolor="transparent", pad="0.35", ranksep="0.45", nodesep="0.3", rankdir="TB", splines="ortho", labelloc="t", label="Methodology Pipeline (241/241 Import-Name Coverage)", fontsize="10", fontcolor="#333333"];
  node [fontname="Helvetica", fontsize="8.5", shape="box", style="rounded,filled", fillcolor="#f8f9fa", color="#333333", penwidth="0.8", margin="0.18,0.09"];
  edge [fontname="Helvetica", fontsize="7", color="#555555", arrowsize="0.7", penwidth="0.9"];

  // legend-style colors
  // blue header, green done, orange action

  s1 [label="1. Scrape\nnltk.org/api\n(HTML index)", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0", fontsize="8.5"];
  s2 [label="241 modules\nenumerated", shape="box", style="rounded,filled", fillcolor="#fef7e0", color="#e8a317", penwidth="1.0"];
  s3 [label="parity-checklist.py\n+ src/_parity.ts\nCOVERED dict", shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#1e8e3e", penwidth="1.0"];
  s4 [label="Classification\nfunctional  vs  import-only", shape="diamond", style="filled", fillcolor="#fce8e6", color="#c5221f", penwidth="1.0", fontsize="8", width="1.55", height="0.95", margin="0.12,0.05"];
  s5a [label="Functional entry\nTypeScript + selected Rust/WASM", shape="box", style="rounded,filled", fillcolor="#e6f4ea", color="#1e8e3e", penwidth="1.0"];
  s5b [label="Import-only entry\nbarrel or documented throw", shape="box", style="rounded,filled", fillcolor="#fef7e0", color="#e8a317", penwidth="1.0"];
  s6 [label="Harness\n432 Bun tests + 37-group differential fidelity gate", shape="box", style="rounded,filled", fillcolor="#e8f0fe", color="#1a73e8", penwidth="1.0"];
  s7 [label="PARITY_CHECKLIST.md + release:local + native-host reports\ncoverage / fidelity / performance / package + runtime gates", shape="box", style="rounded,filled", fillcolor="#f3e8fd", color="#7c4dff", penwidth="1.0"];

  s1 -> s2 [label="  parse headings "];
  s2 -> s3 [label="  emit "];
  s3 -> s4;
  s4 -> s5a [label=" portable "];
  s4 -> s5b [label=" GUI / net "];
  s5a -> s6;
  s5b -> s6 [style="dashed", label="  intentional throw "];
  s6 -> s7 [label="  local validation "];
  s7 -> s3 [style="dotted", color="#7c4dff", label="  regenerates ", constraint="false", penwidth="0.8"];

  // phase bands (invisible grouping via rank)
  { rank="same"; s5a; s5b; }

  // caption note
  note [label="Import coverage and differential behavioral fidelity are reported separately", shape="plaintext", fontsize="6.5", fontcolor="#666666", height="0.2"];
  { rank="sink"; note; }
}
