# bun_nltk environment variables — copy to .env (or export in your shell).
# All are optional; the library works with zero configuration using built-in defaults.

# Path to the compiled Rust native library. Defaults to the prebuilt path
# under native/ produced by `bun run build:rust`.
# BUN_NLTK_NATIVE_LIB=./native/libbun_nltk.dylib

# cargo binary used by build scripts if cargo is not on PATH.
# BUN_NLTK_CARGO_BIN=cargo

# Path to a WordNet data directory to override the bundled mini corpus.
# BUN_NLTK_WORDNET_PATH=/path/to/wordnet

# Max allowed regression percent for bench trend checks in CI.
# BENCH_TREND_MAX_REGRESSION_PCT=10

# Git tag injected into release builds (set automatically in CI).
# GIT_TAG=v0.12.0
